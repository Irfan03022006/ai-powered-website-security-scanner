# Flask
SECRET_KEY=change-this-to-a-random-secret
FLASK_DEBUG=false

# Database (defaults to local SQLite file if omitted)
DATABASE_URL=sqlite:///scanner.db

# AI provider configuration
# AI_PROVIDER can be: anthropic | openai | none
# If AI_API_KEY is not set, the app falls back to a rule-based
# explanation generator so the scanner still works end-to-end.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Scanner / SSRF protection
REQUEST_TIMEOUT_SECONDS=8
MAX_REDIRECTS=5
MAX_RESPONSE_BYTES=2097152

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_SCANS=5
